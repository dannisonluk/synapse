node_modules/
.pnpm-store/

# Build & Dist Outputs
dist/
build/
out/
.turbo/
.vite/

# Vite leaves these behind when a build is interrupted (config is bundled to a
# timestamped temp file, normally deleted on exit).
vite.config.*.timestamp-*.mjs

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/
*.egg-info/
.pytest_cache/

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & IDE Artifacts
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp

# AI assistant workspace (memory notes, local session state — not project source)
.workbuddy-ai/